{
  "name": "@clawkit/sdk",
  "version": "0.1.0",
  "description": "ClawKit 官方 Node.js SDK - 方便第三方应用接入 ClawKit",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "clawkit",
    "ai-automation",
    "workflow",
    "pipeline",
    "sdk"
  ],
  "author": "ClawKit Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clawkit/clawkit",
    "directory": "sdk/javascript"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
