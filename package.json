{
  "name": "clawkit",
  "version": "1.0.0",
  "private": true,
  "description": "一键部署、配置并串联 OpenClaw 与 OpenCode 的轻量工具",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "dev": "pnpm -r --if-present --filter \"!@clawkit/desktop\" dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "desktop:dev": "pnpm --filter @clawkit/desktop dev",
    "desktop:build": "pnpm --filter @clawkit/desktop build",
    "desktop:start": "./scripts/start-desktop.sh",
    "quickstart": "./scripts/quick-start-simple.sh",
    "quickstart:full": "./scripts/quick-start.sh",
    "quickstart:dev": "./scripts/quick-start-dev.sh",
    "project:start": "./scripts/start-project-manager.sh",
    "project:stop": "./scripts/stop-project-manager.sh",
    "smoke": "./scripts/smoke-test.sh",
    "opencode": "./scripts/start-opencode.sh"
  },
  "keywords": [
    "openclaw",
    "opencode",
    "deployment",
    "automation"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "@opencode-ai/sdk": "^1.2.24",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
