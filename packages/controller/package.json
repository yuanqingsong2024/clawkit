{
  "name": "@clawkit/controller",
  "version": "1.0.0",
  "description": "clawkit 控制器服务",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @clawkit/pipeline build && pnpm --filter @clawkit/plugin-core build && tsc && mkdir -p dist/persistence && cp src/persistence/init.sql dist/persistence/init.sql",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "start": "pnpm build && node dist/index.js",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@clawkit/cli": "workspace:*",
    "@clawkit/pipeline": "workspace:*",
    "@clawkit/plugin-core": "workspace:*",
    "@clawkit/shared": "workspace:*",
    "@fastify/websocket": "^10.0.1",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^3.6.0",
    "fastify": "^4.29.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/chokidar": "^2.1.3",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
