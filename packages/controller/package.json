{
  "name": "@clawkit/controller",
  "version": "0.1.0",
  "description": "clawkit 控制器服务",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter @clawkit/cli build && tsc && mkdir -p dist/persistence && cp src/persistence/init.sql dist/persistence/init.sql",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "pnpm build && node tests/run-tests.js"
  },
  "dependencies": {
    "@clawkit/cli": "workspace:*",
    "@clawkit/shared": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "fastify": "^4.29.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "typescript": "^5.3.3"
  }
}
